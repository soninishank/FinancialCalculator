#!/usr/bin/env bash
# Pre-push hook - runs automated UI tests
# Prevents pushing broken code to repository

echo ""
echo "Running pre-push checks..."
echo ""

# Check if dev server is running
SERVER_STARTED_BY_HOOK=false

# Function to safely kill the server on port 3001
cleanup_server() {
  if [ "$SERVER_STARTED_BY_HOOK" = true ]; then
    echo "Stopping background server..."
    # Kill server and its children (macOS-compatible)
    if [ ! -z "$SERVER_PID" ]; then
      pkill -TERM -P $SERVER_PID 2>/dev/null
      kill $SERVER_PID 2>/dev/null
    fi
    
    # Fallback: force kill anything on port 3001 if it's still there
    sleep 1
    if lsof -i:3001 -t >/dev/null; then
       echo "Force refreshing port 3001..."
       lsof -ti:3001 | xargs kill -9 2>/dev/null
    fi
  fi
}

# Register cleanup on exit
trap cleanup_server EXIT

if ! curl -s http://localhost:3001 > /dev/null; then
  echo "Port 3001 is not responding. Building production bundle for testing..."
  # Clean up any stale process first
  lsof -ti:3001 | xargs kill -9 > /dev/null 2>&1
  
  npm run build
  
  echo "Starting production server on port 3001..."
  # Start server in background (macOS-compatible, no setsid)
  npx next start -p 3001 > /dev/null 2>&1 &
  SERVER_PID=$!
  SERVER_STARTED_BY_HOOK=true
  
  # Wait for server to be ready
  MAX_RETRIES=30
  RETRY_COUNT=0
  until curl -s http://localhost:3001 > /dev/null || [ "$RETRY_COUNT" -eq "$MAX_RETRIES" ]; do
    sleep 2
    RETRY_COUNT=$((RETRY_COUNT + 1))
    printf "."
  done
  echo ""

  if [ "$RETRY_COUNT" -eq "$MAX_RETRIES" ]; then
    echo "Error: Failed to start dev server after 60 seconds."
    cleanup_server # Manual call since trap might not trigger on immediate exit? Actually it should.
    exit 1
  fi
  echo "Server is ready!"
fi

# Run Sync Script to include new calculators
echo "Syncing test suite with latest manifest..."
node scripts/qa/sync-test-calculators.js

# Run UI tests
echo "Running UI tests on all calculators..."

TEST_URL=http://localhost:3001 node scripts/qa/test-all-calculators.js

# Capture exit code
TEST_EXIT_CODE=$?

# Hook validation
if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "Tests failed! Push blocked."
  echo "Fix the issues and try again."
  echo ""
  exit 1
fi

echo ""
echo "All tests passed! Proceeding with push..."
echo ""

exit 0
