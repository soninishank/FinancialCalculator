#!/usr/bin/env bash
# Pre-push hook - runs automated UI tests
# Prevents pushing broken code to repository

echo ""
echo "🔍 Running pre-push checks..."
echo ""

# Check if dev server is running
if ! curl -s http://localhost:3000 > /dev/null; then
  echo "❌ Dev server is not running!"
  echo "   Please start it with: npm run dev"
  echo ""
  exit 1
fi

# Run Sync Script to include new calculators
echo "🔄 Syncing test suite with latest manifest..."
node scripts/sync-test-calculators.js

# Run UI tests
echo "🧪 Running UI tests on all calculators..."

node scripts/test-all-calculators.js

# Capture exit code
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Tests failed! Push blocked."
  echo "   Fix the issues and try again."
  echo ""
  exit 1
fi

echo ""
echo "✅ All tests passed! Proceeding with push..."
echo ""

exit 0
